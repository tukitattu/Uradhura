# ============================================================
# GAMING PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values
# ============================================================

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gaming_platform
DB_USER=gaming_admin
DB_PASSWORD=super_secret_password_123
DATABASE_URL=postgresql://gaming_admin:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ----------------------------------------------------------
# REDIS
# ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ----------------------------------------------------------
# API SERVER
# ----------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=api

# ----------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
CORS_ORIGIN=http://localhost,http://localhost:80,https://yourdomain.com

# ----------------------------------------------------------
# NEXT.JS ADMIN
# ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=http://localhost/ws
NEXT_PUBLIC_APP_NAME=Uradhura Gaming Platform

# ----------------------------------------------------------
# DOCKER
# ----------------------------------------------------------
COMPOSE_PROJECT_NAME=gaming_platform

# ----------------------------------------------------------
# DEPLOYMENT (GitHub Actions)
# ----------------------------------------------------------
# DOCKER_REGISTRY=ghcr.io
# DOCKER_IMAGE_PREFIX=ghcr.io/your-org/gaming-platform
# DEPLOY_HOST=your-server.example.com
# DEPLOY_USER=deploy
# DEPLOY_SSH_KEY=your-ssh-private-key
