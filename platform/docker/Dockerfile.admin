# ============================================================
# GAMING PLATFORM — NEXT.JS ADMIN DOCKERFILE
# Multi-stage build for production
# ============================================================

# ----------------------------------------------------------
# Stage 1: Builder — install deps, build Next.js app
# ----------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files for layer caching
COPY apps/admin/package.json apps/admin/package-lock.json* ./

# Install all dependencies
RUN npm ci --legacy-peer-deps

# Copy config files
COPY apps/admin/tsconfig.json tsconfig.json
COPY apps/admin/next.config.js next.config.js
COPY apps/admin/tailwind.config.* ./
COPY apps/admin/postcss.config.* ./

# Copy application source (Next.js auto-detects src/app)
COPY apps/admin/src ./src

# Public env vars — baked into the JS bundle at build time.
ARG NEXT_PUBLIC_API_URL=http://bgwingbangkadesh.com/api
ARG NEXT_PUBLIC_WS_URL=ws://bgwingbangkadesh.com/ws
ARG NEXT_PUBLIC_APP_URL=http://bgwingbangkadesh.com
ARG NEXT_PUBLIC_APP_NAME=Uradhura Gaming Platform
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME

# Build the Next.js application
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Prune devDependencies
RUN npm prune --production --legacy-peer-deps

# ----------------------------------------------------------
# Stage 2: Runner — lean production image
# ----------------------------------------------------------
FROM node:20-alpine AS runner

# Security: run as non-root
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

# Copy only production artifacts
COPY --from=builder --chown=appuser:appgroup /app/.next ./.next
COPY --from=builder --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --from=builder --chown=appuser:appgroup /app/package.json ./package.json
COPY --from=builder --chown=appuser:appgroup /app/next.config.js ./next.config.js

# Set environment
ENV NODE_ENV=production
ENV PORT=3001
ENV NEXT_TELEMETRY_DISABLED=1

# Expose admin port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3001/ || exit 1

# Switch to non-root user
USER appuser

# Start the application
CMD ["npm", "start"]
