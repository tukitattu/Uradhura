# Database (PostgreSQL 16 — see platform/docker)
DATABASE_URL="postgresql://gaming_admin:super_secret_password_123@localhost:5432/gaming_platform"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=4002
API_PREFIX=api/v1

# CORS
CORS_ORIGIN=http://localhost:3001

# ============================================
# ASSET REGISTRY
# ============================================
# Local disk root for uploaded/published media (nginx also maps this dir)
ASSET_STORAGE_PATH=./storage/assets
# URL prefix the API exposes for asset files
ASSET_PUBLIC_ROOT=/assets
# Public base URL used to build absolute URLs in the asset manifest
PUBLIC_API_URL=http://localhost:4002
# Max accepted upload size in bytes (multipart)
ASSET_MAX_FILE_SIZE=20971520
