  claimedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player @relation(fields: [playerId], references: [id])
  task      Task   @relation(fields: [taskId], references: [id])

  @@unique([playerId, taskId])
  @@map("player_tasks")
}

// ============================================================
// RANKINGS
