  bootAmount      Int      @default(10)
  chaalCap        Int      @default(4)
  maxSeats        Int      @default(6)
  minPlayers      Int      @default(3)
  minBuyIn        Int      @default(100)
  maxBuyIn        Int      @default(10000)
  botFill         Boolean  @default(true)
  status          String   @default("open") // open, playing, closed
  serverSeed      String
  serverSeedHash  String
  nextHandNo      Int      @default(1)
  dealerSeatNo    Int      @default(1)
  handInPlay      Boolean  @default(false)
