  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ranking   Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([rankingId, playerId, period])
  @@index([rankingId, score])
  @@map("ranking_entries")
}

// ============================================================
// MODERATION & REPORTS
// ============================================================

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String   // player, live_room, post, message, game
  targetId    String
  reason      String
  category    String   @default("general") // spam, harassment, cheating, inappropriate, other
  description String?
  status      String   @default("pending") // pending, reviewing, resolved, dismissed
  assignedTo  String?  // Admin user ID
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  reporter    Player   @relation("Reporter", fields: [reporterId], references: [id])
  target      Player?  @relation("Target", fields: [targetId], references: [id])
  room        LiveRoom? @relation(fields: [roomId], references: [id])
  roomId      String?

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model ModerationAction {
  id          String   @id @default(uuid())
  adminId     String?  // Admin who performed action
  targetType  String   // player, room, post, message
  targetId    String
  action      String   // warn, mute, ban, unban, delete, restrict
  reason      String?
  duration    Int?     // Duration in hours for temporary actions
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  admin       AdminUser? @relation(fields: [adminId], references: [id], name: "ModerationAdmin")
  player      Player     @relation(fields: [targetId], references: [id], name: "ModerationTarget")

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

// ============================================================
// NOTIFICATIONS
