// ============================================================
// URADHURA GAMING + SOCIAL PLATFORM — COMPLETE DATABASE SCHEMA
// Step 1: Database Foundation (PostgreSQL 16)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & RBAC
// ============================================================

model AdminUser {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatar        String?
  isActive      Boolean   @default(true)
  suspendedAt   DateTime?
  suspendedReason String?
  createdBy     String?   // super admin who created this account
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         AdminUserRole[]
  refreshTokens RefreshToken[]
  gameAssignments    AdminGame[]
  permissionOverrides AdminPermission[]
  subscription  AdminSubscription?
  invoices      AdminInvoice[]
  commissions   AdminCommission[]
  moderationActions ModerationAction[] @relation("ModerationAdmin")
  updatedWithdrawalRules WithdrawalRule[]    @relation("WithdrawalRuleUpdatedBy")
  grantedWithdrawalOverrides PlayerWithdrawalOverride[] @relation("WithdrawalOverrideGrantedBy")
  reviewedWithdrawals   WithdrawalRequest[]  @relation("WithdrawalRequestReviewer")
  updatedTeenPattiConfigs TeenPattiConfig[]  @relation("TeenPattiConfigUpdatedBy")
  createdAssets      Asset[] @relation("AssetCreator")
  updatedAssets      Asset[] @relation("AssetUpdater")

  @@map("admin_users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // super_admin, admin, game_operator, finance, moderator, support, viewer
  displayName String
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // games, players, wallet, economy, live, chat, moderation, etc.
  action      String   // view, create, edit, delete, configure, publish, approve, override, export, moderate
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]
  admins      AdminPermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model AdminUserRole {
  id        String   @id @default(uuid())
  adminId   String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())

  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Per-admin game assignment. An admin can only operate on assigned games.
model AdminGame {
  id        String   @id @default(uuid())
  adminId   String
  gameId    String
  canView   Boolean  @default(true)
  canEdit   Boolean  @default(false)
  grantedBy String?
  grantedAt DateTime @default(now())

  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([adminId, gameId])
  @@index([gameId])
  @@map("admin_games")
}

// Per-admin permission override (grant or revoke) on top of role permissions.
model AdminPermission {
  id           String   @id @default(uuid())
  adminId      String
  permissionId String
  effect       String   @default("allow") // allow | deny
  grantedBy    String?
  createdAt    DateTime @default(now())

  admin        AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminId, permissionId])
  @@map("admin_permissions")
}

// Monthly access / commission plan offered to admins by the super admin.
model AdminPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  currency        String   @default("USD")
  monthlyFeeCents Int      @default(0)
  commissionRate  Decimal  @default(0) // percent of the admin's game house earnings
  maxGames        Int?     // null = unlimited
  features        String?  // JSON feature list
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   AdminSubscription[]

  @@map("admin_plans")
}

model AdminSubscription {
  id                 String    @id @default(uuid())
  adminId            String    @unique
  planId             String
  status             String    @default("active") // active, past_due, cancelled, expired
  paymentStatus      String    @default("unpaid") // unpaid, paid, overdue
  startedAt          DateTime  @default(now())
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  accessExpiresAt    DateTime?
  lastPaymentAt      DateTime?
  nextPaymentDueAt   DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  admin              AdminUser      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  plan               AdminPlan      @relation(fields: [planId], references: [id])
  invoices           AdminInvoice[]

  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("admin_subscriptions")
}

model AdminInvoice {
  id             String    @id @default(uuid())
  adminId        String
  subscriptionId String?
  currency       String    @default("USD")
  amountCents    Int
  status         String    @default("unpaid") // unpaid, paid, void, refunded
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  externalRef    String?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  admin          AdminUser         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  subscription   AdminSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([status, dueAt])
  @@map("admin_invoices")
}

// Commission owed to an admin for a billing period, computed from settled rounds.
model AdminCommission {
  id             String   @id @default(uuid())
  adminId        String
  gameId         String?
  periodStart    DateTime
  periodEnd      DateTime
  turnover       Decimal  @default(0)
  houseEarnings  Decimal  @default(0)
  commissionRate Decimal  @default(0)
  commissionAmount Decimal @default(0)
  currency       String   @default("coins")
  status         String   @default("pending") // pending, approved, paid, void
  paidAt         DateTime?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  game           Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([adminId, gameId, periodStart, periodEnd])
  @@index([status, periodEnd])
  @@map("admin_commissions")
}

// ============================================================
// PLAYERS
// ============================================================

model Player {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  displayName     String?
  avatar          String?
  avatarFrame     String?
  badge           String?
  levelId         String?
  agencyId        String?
  familyId        String?
  country         String?
  language        String    @default("en")
  isActive        Boolean   @default(true)
  isBanned        Boolean   @default(false)
  banReason       String?
  kycVerified     Boolean   @default(false)
  withdrawalBlacklisted    Boolean @default(false)
  withdrawalWhitelisted    Boolean @default(false)
  withdrawalBlacklistReason String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet          WalletAccount?
  walletTransactions WalletTransaction[]
  bets            GameBet[]
  settlements     GameSettlement[]
  refreshTokens   PlayerRefreshToken[]
  ownedLiveRooms  LiveRoom[]
  liveRoomMemberships RoomMember[]
  messages        Message[]
  sentGifts       GiftTransaction[]   @relation("Sender")
  receivedGifts   GiftTransaction[]   @relation("Receiver")
  posts           Post[]
  postLikes       PostLike[]
  postComments    PostComment[]
  reportsFiled    Report[]            @relation("Reporter")
  reportsTarget   Report[]            @relation("Target")
  moderationActions ModerationAction[] @relation("ModerationTarget")
  notifications   Notification[]
  agencyMemberships AgencyMember[]
  familyMemberships FamilyMember[]
  tasks           PlayerTask[]
  rewards         PlayerReward[]
  rankings        RankingEntry[]
  paymentOrders   PaymentOrder[]
  withdrawalRequests WithdrawalRequest[] @relation("WithdrawalRequestPlayer")
  withdrawalOverrides PlayerWithdrawalOverride[] @relation("PlayerWithdrawalOverridePlayer")
  agency          Agency?             @relation("AgencyOwner")
  family          Family?             @relation("FamilyOwner")
  level           Level?              @relation(fields: [levelId], references: [id])
  following       FollowRelation[]    @relation("Following")
  followers       FollowRelation[]    @relation("Followers")
  blockedUsers    BlockRelation[]     @relation("Blocker")
  blockedBy       BlockRelation[]     @relation("Blocked")
  playerSettings  PlayerSetting[]
  gameSeeds       GameSeed[]
  sentTransfers   WalletTransfer[] @relation("TransferSender")
  receivedTransfers WalletTransfer[] @relation("TransferReceiver")
  gameAccess      PlayerGameAccess[]
  limits          PlayerLimit?
  teenPattiSeats     TeenPattiSeat[]
  teenPattiHandSeats TeenPattiSeatHand[]
  teenPattiActions   TeenPattiAction[]

  @@map("players")
}

model PlayerRefreshToken {
  id        String   @id @default(uuid())
  playerId  String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_refresh_tokens")
}

model PlayerSetting {
  id       String @id @default(uuid())
  playerId String
  key      String
  value    String // JSON string

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, key])
  @@map("player_settings")
}

// ============================================================
// WALLET & LEDGER (IMMUTABLE)
// ============================================================

model WalletAccount {
  id           String   @id @default(uuid())
  playerId     String   @unique
  coinBalance  Decimal  @default(0)
  diamondBalance Decimal @default(0)
  totalCoinsEarned  Decimal @default(0)
  totalCoinsSpent   Decimal @default(0)
  totalDiamondsEarned Decimal @default(0)
  totalDiamondsSpent  Decimal @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet_accounts")
}

model WalletTransaction {
  id              String   @id @default(uuid())
  walletAccountId String
  playerId        String
  type            String   // coin_purchase, diamond_purchase, bet_debit, bet_credit, gift_send, gift_receive, reward, admin_adjustment, level_up_bonus, task_reward, agency_commission
  currency        String   @default("coins") // coins, diamonds
  amount          Decimal 
  balanceBefore   Decimal 
  balanceAfter    Decimal 
  referenceType   String?  // game_round, gift, package, admin, reward, task
  referenceId     String?  // ID of the related entity
  description     String?
  idempotencyKey  String   @unique
  metadata        String?    // Additional context data
  createdBy       String?  // admin ID for manual adjustments
  createdAt       DateTime @default(now())

  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id])
  player          Player        @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
  @@index([walletAccountId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

// ============================================================
// GAMES — MASTER
// ============================================================

model Game {
  id              String   @id @default(uuid())
  internalCode    String   @unique // greedy_monkey, greedy_lion, teen_patti, food_wheel, three_card, slot
  name            String
  displayName     String
  description     String?
  shortDescription String?
  category        String?  // wheel, card, slot, package
  gameType        String?  // betting, guessing, spinning
  status          String   @default("inactive") // inactive, active, maintenance
  version         Int      @default(1)
  sortOrder       Int      @default(0)
  isFeatured      Boolean  @default(false)
  isHot           Boolean  @default(false)
  isRecommended   Boolean  @default(false)
  maintenanceMessage String?
  thumbnail       String?
  banner          String?
  icon            String?
  background      String?
  logo            String?
  centralCharacter String?
  characterAnimation String?
  characterName   String?
  rules           String?    // Game rules as structured JSON
  helpContent     String?    // Help/FAQ content
  sounds          String?    // Sound configuration
  music           String?    // Music configuration
  theme           String?    // Theme configuration
  colorConfig     String?    // Color configuration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configurations  GameConfiguration[]
  options         GameOption[]
  rounds          GameRound[]
  assets          GameAsset[]
  localizations   GameLocalization[]
  betConfigs      GameBetConfig[]
  seeds           GameSeed[]
  adminAssignments AdminGame[]
  playerAccess    PlayerGameAccess[]
  commissions     AdminCommission[]

  @@map("games")
}

model GameConfiguration {
  id              String   @id @default(uuid())
  gameId          String
  version         Int      @default(1)
  houseEdge       Decimal  @default(5.0) // percent
  maxPayoutPerRound Decimal @default(10000)
  jackpotWeight   Decimal  @default(1.0)
  vipAdjustment   Decimal  @default(0.0)
  maxDailyLossPerPlayer Decimal @default(100000)
  bettingDurationSeconds Int @default(30)
  roundDurationSeconds   Int @default(30)
  resultProcessingDelayMs Int @default(5000)
  newRoundDelayMs  Int    @default(3000)
  minPlayers       Int    @default(0)
  maxPlayers       Int    @default(1000)
  isActive         Boolean @default(true)
  configData       String?   // Game-specific configuration
  createdBy        String? // admin user ID
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, version])
  @@map("game_configurations")
}

model GameBetConfig {
  id           String  @id @default(uuid())
  gameId       String
  denominations String   @default("[100,500,1000,5000,10000]") // Array of allowed bet amounts
  minBet       Decimal @default(100)
  maxBet       Decimal @default(1000000)
  allowCustomBet Boolean @default(false)
  allowMultipleSelections Boolean @default(false)
  allowRepeatBet Boolean @default(true)
  allowAutoBet   Boolean @default(true)
  allowAutoPlay  Boolean @default(false)
  maxAutoBetRounds Int @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game         Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId])
  @@map("game_bet_configs")
}

model GameOption {
  id          String  @id @default(uuid())
  gameId      String
  name        String
  label       String
  icon        String?
  image       String?
  positionX   Float?  // X position for circular layout
  positionY   Float?  // Y position for circular layout
  multiplier  Decimal
  weight      Decimal @default(1.0) // For weighted RNG
  isHot       Boolean @default(false)
  isRecommended Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  colorHex    String  @default("#ffffff")
  metadata    String?   // Additional option data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  bets        GameBet[]
  results     GameResult[]

  @@map("game_options")
}

// ============================================================
// GAME ROUNDS
// ============================================================

model GameRound {
  id            String    @id @default(uuid())
  gameId        String
  roundNumber   Int
  status        String    @default("upcoming") // upcoming, betting_open, betting_closed, result_processing, settled, closed
  bettingOpensAt DateTime?
  bettingEndsAt DateTime?
  resultData    String?     // Server-generated result
  winnerId      String?   // Winning option ID
  winnerLabel   String?
  totalBetAmount Decimal  @default(0)
  totalPayout   Decimal   @default(0)
  houseEdge     Decimal? 
  jackpotWeight Decimal? 
  configVersion Int?      // Which config version was used
  metadata      String?     // Round metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  settledAt     DateTime?
  closedAt      DateTime?

  game          Game          @relation(fields: [gameId], references: [id])
  bets          GameBet[]
  result        GameResult?
  settlements   GameSettlement[]
  seed          GameSeed?     @relation("RoundSeed", fields: [seedId], references: [id])
  seedId        String?       @unique

  @@unique([gameId, roundNumber])
  @@index([gameId, status])
  @@index([status, bettingEndsAt])
  @@map("game_rounds")
}

// ============================================================
// GAME BETS
// ============================================================

model GameBet {
  id             String   @id @default(uuid())
  roundId        String
  playerId       String
  optionId       String
  amount         Decimal 
  potentialPayout Decimal
  status         String   @default("pending") // pending, won, lost, refunded, cancelled
  payout         Decimal?
  multiplierSnapshot Decimal? // Multiplier at time of bet
  idempotencyKey String   @unique
  txRef          String?  // Wallet transaction reference
  metadata       String?    // Bet metadata
  createdAt      DateTime @default(now())
  settledAt      DateTime?

  round          GameRound      @relation(fields: [roundId], references: [id])
player        Player         @relation(fields: [playerId], references: [id])
  option        GameOption     @relation(fields: [optionId], references: [id])
  settlement    GameSettlement?

  @@index([roundId])
  @@index([playerId, createdAt])
  @@index([status])
  @@map("game_bets")
}

// ============================================================
// GAME SEEDS (PROVABLY FAIR)
// ============================================================

model GameSeed {
  id             String    @id @default(uuid())
  gameId         String
  roundId        String?   @unique
  playerId       String?   // Player-chosen client seed; null when the platform provides it
  clientSeed     String
  serverSeed     String    // Revealed ONLY after rounds using it settle
  serverSeedHash String    // SHA-256 commitment published BEFORE the betting window
  nonce          Int       @default(0) // Incremented per use of the same seed pair
  seedLength     Int       @default(32) // Entropy source length for this seed
  usedAt         DateTime? // First round that consumed this seed
  revealedAt     DateTime? // When serverSeed was disclosed for audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  game          Game        @relation(fields: [gameId], references: [id])
  round         GameRound?  @relation("RoundSeed")
  player        Player?     @relation(fields: [playerId], references: [id])

  @@index([gameId, playerId, usedAt])
  @@index([roundId])
  @@map("game_seeds")
}

// ============================================================
// GAME RESULTS
// ============================================================

model GameResult {
  id           String   @id @default(uuid())
  roundId      String   @unique
  optionId     String   // Winning option ID
  winningLabel String
  resultData   String     @default("{}") // Card values, reel positions, etc.
  processedAt  DateTime @default(now())
  processedBy  String   @default("system") // system | admin
  seed         String?  // RNG seed for audit
  metadata     String?

  round        GameRound @relation(fields: [roundId], references: [id])
  option       GameOption @relation(fields: [optionId], references: [id])

  @@map("game_results")
}

// ============================================================
// GAME SETTLEMENTS
// ============================================================

model GameSettlement {
  id          String   @id @default(uuid())
  roundId     String
  betId       String   @unique // Prevents double payout
  playerId    String
  payout      Decimal 
  status      String   @default("pending") // pending, completed, failed
  txRef       String?  // Wallet transaction reference
  settledAt   DateTime?
  createdAt   DateTime @default(now())

  round       GameRound @relation(fields: [roundId], references: [id])
  bet         GameBet   @relation(fields: [betId], references: [id])
  player      Player    @relation(fields: [playerId], references: [id])

  @@index([roundId])
  @@index([playerId])
  @@map("game_settlements")
}

// ============================================================
// GAME ASSETS
// ============================================================

model GameAsset {
  id          String   @id @default(uuid())
  gameId      String
  type        String   // thumbnail, banner, icon, background, character, animation, sound, music
  name        String
  url         String
  fileSize    Int?
  mimeType    String?
  metadata    String?    // Width, height, duration, etc.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game        Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("game_assets")
}

// ============================================================
// GAME LOCALIZATION
// ============================================================

model GameLocalization {
  id        String @id @default(uuid())
  gameId    String
  locale    String // en, es, zh, hi, ar, etc.
  key       String // rules.title, rules.bet_button, etc.
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game      Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, locale, key])
  @@map("game_localizations")
}

// ============================================================
// VIRTUAL ECONOMY
// ============================================================

model CoinPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  priceUsd      Decimal 
  priceLocal    Decimal?
  currency      String   @default("USD")
  baseCoins     Int
  bonusCoins    Int      @default(0)
  isSpecialOffer Boolean @default(false)
  isPopular     Boolean  @default(false)
  expiryDays    Int      @default(30)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  isVisibleInStore Boolean @default(true)
  image         String?
  metadata      String?    // Store visibility, categories, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paymentOrders PaymentOrder[]

  @@map("coin_packages")
}

model DiamondPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  priceUsd      Decimal 
  baseDiamonds  Int
  bonusDiamonds Int      @default(0)
  isSpecialOffer Boolean @default(false)
  isPopular     Boolean  @default(false)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("diamond_packages")
}

model Gift {
  id          String   @id @default(uuid())
  name        String
  icon        String
  animation   String?
  coinPrice   Decimal 
  category    String   @default("general") // general, special, seasonal, premium
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  senderRules String?    // Who can send
  receiverRules String?  // Who can receive
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions GiftTransaction[]

  @@map("gifts")
}

model GiftTransaction {
  id          String   @id @default(uuid())
  giftId      String
  senderId    String
  receiverId  String
  roomId      String?  // Live room ID if sent in room
  quantity    Int      @default(1)
  totalCost   Decimal 
  txRef       String   @unique // Idempotency key
  metadata    String?
  createdAt   DateTime @default(now())

  gift        Gift          @relation(fields: [giftId], references: [id])
  sender      Player        @relation("Sender", fields: [senderId], references: [id])
  receiver    Player        @relation("Receiver", fields: [receiverId], references: [id])
  room        LiveRoom?     @relation(fields: [roomId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@map("gift_transactions")
}

// ============================================================
// PAYMENTS
// ============================================================

model PaymentOrder {
  id              String   @id @default(uuid())
  playerId        String
  packageId       String?
  packageType     String   // coin, diamond
  provider        String   // stripe, apple, google, manual, bank_transfer
  providerOrderId String?
  externalOrderId String?
  currency        String   @default("USD")
  amountCents     Int
  tokenAmount     Int      // coins or diamonds to credit
  status          String   @default("pending") // pending, completed, failed, refunded, expired
  idempotencyKey  String?  @unique
  failureReason   String?
  receiptData     String?
  metadata        String?
  creditedAt      DateTime?
  refundedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player          Player      @relation(fields: [playerId], references: [id])
  coinPackage     CoinPackage? @relation(fields: [packageId], references: [id])
  webhookEvents   PaymentWebhookEvent[]

  @@unique([provider, externalOrderId])
  @@index([playerId, createdAt])
  @@index([status, createdAt])
  @@map("payment_orders")
}

// Idempotency + audit record for every inbound payment-provider webhook.
// (provider, eventId) is unique so a replayed webhook is processed exactly once.
model PaymentWebhookEvent {
  id             String   @id @default(uuid())
  provider       String
  eventId        String
  eventType      String
  paymentOrderId String?
  signatureValid Boolean  @default(false)
  status         String   @default("received") // received, processed, ignored, failed
  payload        String
  error          String?
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@index([paymentOrderId])
  @@map("payment_webhook_events")
}

// Atomic, idempotent player-to-player wallet transfer.
model WalletTransfer {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  currency   String   @default("coins")
  amount     Decimal
  fee        Decimal  @default(0)
  status     String   @default("completed") // completed, reversed, failed
  txRef      String   @unique // idempotency key
  note       String?
  metadata   String?
  createdAt  DateTime @default(now())
  reversedAt DateTime?

  sender     Player @relation("TransferSender", fields: [senderId], references: [id])
  receiver   Player @relation("TransferReceiver", fields: [receiverId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@map("wallet_transfers")
}

// Per-player game availability/eligibility (overrides global game status).
model PlayerGameAccess {
  id        String   @id @default(uuid())
  playerId  String
  gameId    String
  isEnabled Boolean  @default(true)
  reason    String?
  grantedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameId])
  @@index([gameId, isEnabled])
  @@map("player_game_access")
}

// Responsible-gaming controls (explicit limits / self-exclusion).
model PlayerLimit {
  id                    String    @id @default(uuid())
  playerId              String    @unique
  currency              String    @default("coins")
  dailyDepositLimitCents Int?
  dailyLossLimit        Decimal?
  dailyBetLimit         Decimal?
  weeklyLossLimit       Decimal?
  maxSessionMinutes     Int?
  selfExcludedUntil     DateTime?
  coolOffUntil          DateTime?
  selfExclusionReason   String?
  updatedBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  player                Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_limits")
}

// ============================================================
// LIVE ROOMS
// ============================================================

model LiveRoom {
  id           String   @id @default(uuid())
  hostId       String
  title        String
  cover        String?
  description  String?
  roomType     String   @default("live") // live, voice, party
  status       String   @default("active") // active, ended, suspended
  viewerCount  Int      @default(0)
  maxViewers   Int      @default(10000)
  isPrivate    Boolean  @default(false)
  accessLevel  String   @default("public") // public, followers, private
  region       String?  // Global, South Asia, Middle East, etc.
  category     String?
  tags         String?
  settings     String?    // Room-specific settings
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  endedAt      DateTime?

  host         Player        @relation(fields: [hostId], references: [id])
  members      RoomMember[]
  messages     Message[]
  roomGifts    GiftTransaction[]
  reports      Report[]

  @@index([hostId])
  @@index([status, roomType])
  @@index([region, category])
  @@map("live_rooms")
}

model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  playerId  String
  role      String   @default("viewer") // host, co_host, moderator, viewer
  isMuted   Boolean  @default(false)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id])

  @@unique([roomId, playerId])
  @@map("room_members")
}

// ============================================================
// MESSAGING
// ============================================================

model Message {
  id         String   @id @default(uuid())
  roomId     String?
  senderId   String
  receiverId String?  // For DMs
  type       String   @default("chat") // chat, system, notification, dm
  content    String
  metadata   String?
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  room       LiveRoom? @relation(fields: [roomId], references: [id])
  sender     Player    @relation(fields: [senderId], references: [id])

