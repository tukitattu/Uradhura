  tableId   String
  seatNo    Int
  playerId  String?
  name      String
  isBot     Boolean  @default(false)
  chips     Int      @default(0)
  isSeated  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  clientSeed String? // player-chosen client seed for the next dealt hand

  table     TeenPattiTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  player    Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([tableId, seatNo])
  @@unique([playerId, tableId])
