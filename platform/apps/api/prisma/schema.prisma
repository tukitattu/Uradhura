// ============================================================
// GAMING + SOCIAL PLATFORM — COMPLETE DATABASE SCHEMA
// Step 1: Database Foundation
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & RBAC
// ============================================================

model AdminUser {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         AdminUserRole[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@map("admin_users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // super_admin, admin, game_operator, finance, moderator, support, viewer
  displayName String
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // games, players, wallet, economy, live, chat, moderation, etc.
  action      String   // view, create, edit, delete, configure, publish, approve, override, export, moderate
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model AdminUserRole {
  id        String   @id @default(uuid())
  adminId   String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())

  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================================
// PLAYERS
// ============================================================

model Player {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  displayName     String?
  avatar          String?
  avatarFrame     String?
  badge           String?
  levelId         String?
  agencyId        String?
  familyId        String?
  country         String?
  language        String    @default("en")
  isActive        Boolean   @default(true)
  isBanned        Boolean   @default(false)
  banReason       String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet          WalletAccount?
  walletTransactions WalletTransaction[]
  bets            GameBet[]
  settlements     GameSettlement[]
  auditLogs       AuditLog[]     @relation("AuditPlayer")
  refreshTokens   PlayerRefreshToken[]
  ownedLiveRooms  LiveRoom[]
  liveRoomMemberships RoomMember[]
  messages        Message[]
  sentGifts       GiftTransaction[]   @relation("Sender")
  receivedGifts   GiftTransaction[]   @relation("Receiver")
  posts           Post[]
  postLikes       PostLike[]
  postComments    PostComment[]
  reportsFiled    Report[]            @relation("Reporter")
  reportsTarget   Report[]            @relation("Target")
  moderationActions ModerationAction[] @relation("ModerationTarget")
  moderationActionsIssued ModerationAction[] @relation("ModerationAdmin")
  notifications   Notification[]
  agencyMemberships AgencyMember[]
  familyMemberships FamilyMember[]
  tasks           PlayerTask[]
  rewards         PlayerReward[]
  rankings        RankingEntry[]
  paymentOrders   PaymentOrder[]
  agency          Agency?             @relation("AgencyOwner")
  family          Family?             @relation("FamilyOwner")
  level           Level?              @relation(fields: [levelId], references: [id])
  following       FollowRelation[]    @relation("Following")
  followers       FollowRelation[]    @relation("Followers")
  blockedUsers    BlockRelation[]     @relation("Blocker")
  blockedBy       BlockRelation[]     @relation("Blocked")
  playerSettings  PlayerSetting[]

  @@map("players")
}

model PlayerRefreshToken {
  id        String   @id @default(uuid())
  playerId  String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_refresh_tokens")
}

model PlayerSetting {
  id       String @id @default(uuid())
  playerId String
  key      String
  value    String // JSON string

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, key])
  @@map("player_settings")
}

// ============================================================
// WALLET & LEDGER (IMMUTABLE)
// ============================================================

model WalletAccount {
  id           String   @id @default(uuid())
  playerId     String   @unique
  coinBalance  Decimal  @default(0)
  diamondBalance Decimal @default(0)
  totalCoinsEarned  Decimal @default(0)
  totalCoinsSpent   Decimal @default(0)
  totalDiamondsEarned Decimal @default(0)
  totalDiamondsSpent  Decimal @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet_accounts")
}

model WalletTransaction {
  id              String   @id @default(uuid())
  walletAccountId String
  playerId        String
  type            String   // coin_purchase, diamond_purchase, bet_debit, bet_credit, gift_send, gift_receive, reward, admin_adjustment, level_up_bonus, task_reward, agency_commission
  currency        String   @default("coins") // coins, diamonds
  amount          Decimal 
  balanceBefore   Decimal 
  balanceAfter    Decimal 
  referenceType   String?  // game_round, gift, package, admin, reward, task
  referenceId     String?  // ID of the related entity
  description     String?
  idempotencyKey  String   @unique
  metadata        String?    // Additional context data
  createdBy       String?  // admin ID for manual adjustments
  createdAt       DateTime @default(now())

  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id])
  player          Player        @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
  @@index([walletAccountId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

// ============================================================
// GAMES — MASTER
// ============================================================

model Game {
  id              String   @id @default(uuid())
  internalCode    String   @unique // greedy_monkey, greedy_lion, teen_patti, food_wheel, three_card, slot
  name            String
  displayName     String
  description     String?
  shortDescription String?
  category        String?  // wheel, card, slot, package
  gameType        String?  // betting, guessing, spinning
  status          String   @default("inactive") // inactive, active, maintenance
  version         Int      @default(1)
  sortOrder       Int      @default(0)
  isFeatured      Boolean  @default(false)
  isHot           Boolean  @default(false)
  isRecommended   Boolean  @default(false)
  maintenanceMessage String?
  thumbnail       String?
  banner          String?
  icon            String?
  background      String?
  logo            String?
  centralCharacter String?
  characterAnimation String?
  characterName   String?
  rules           String?    // Game rules as structured JSON
  helpContent     String?    // Help/FAQ content
  sounds          String?    // Sound configuration
  music           String?    // Music configuration
  theme           String?    // Theme configuration
  colorConfig     String?    // Color configuration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configurations  GameConfiguration[]
  options         GameOption[]
  rounds          GameRound[]
  assets          GameAsset[]
  localizations   GameLocalization[]
  betConfigs      GameBetConfig[]

  @@map("games")
}

model GameConfiguration {
  id              String   @id @default(uuid())
  gameId          String
  version         Int      @default(1)
  houseEdge       Decimal  @default(5.0) // percent
  maxPayoutPerRound Decimal @default(10000)
  jackpotWeight   Decimal  @default(1.0)
  vipAdjustment   Decimal  @default(0.0)
  maxDailyLossPerPlayer Decimal @default(100000)
  bettingDurationSeconds Int @default(30)
  roundDurationSeconds   Int @default(30)
  resultProcessingDelayMs Int @default(5000)
  newRoundDelayMs  Int    @default(3000)
  minPlayers       Int    @default(0)
  maxPlayers       Int    @default(1000)
  isActive         Boolean @default(true)
  configData       String?   // Game-specific configuration
  createdBy        String? // admin user ID
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, version])
  @@map("game_configurations")
}

model GameBetConfig {
  id           String  @id @default(uuid())
  gameId       String
  denominations String   @default("[100,500,1000,5000,10000]") // Array of allowed bet amounts
  minBet       Decimal @default(100)
  maxBet       Decimal @default(1000000)
  allowCustomBet Boolean @default(false)
  allowMultipleSelections Boolean @default(false)
  allowRepeatBet Boolean @default(true)
  allowAutoBet   Boolean @default(true)
  allowAutoPlay  Boolean @default(false)
  maxAutoBetRounds Int @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game         Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId])
  @@map("game_bet_configs")
}

model GameOption {
  id          String  @id @default(uuid())
  gameId      String
  name        String
  label       String
  icon        String?
  image       String?
  positionX   Float?  // X position for circular layout
  positionY   Float?  // Y position for circular layout
  multiplier  Decimal
  weight      Decimal @default(1.0) // For weighted RNG
  isHot       Boolean @default(false)
  isRecommended Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  colorHex    String  @default("#ffffff")
  metadata    String?   // Additional option data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  bets        GameBet[]
  results     GameResult[]

  @@map("game_options")
}

// ============================================================
// GAME ROUNDS
// ============================================================

model GameRound {
  id            String    @id @default(uuid())
  gameId        String
  roundNumber   Int
  status        String    @default("upcoming") // upcoming, betting_open, betting_closed, result_processing, settled, closed
  bettingOpensAt DateTime?
  bettingEndsAt DateTime?
  resultData    String?     // Server-generated result
  winnerId      String?   // Winning option ID
  winnerLabel   String?
  totalBetAmount Decimal  @default(0)
  totalPayout   Decimal   @default(0)
  houseEdge     Decimal? 
  jackpotWeight Decimal? 
  configVersion Int?      // Which config version was used
  metadata      String?     // Round metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  settledAt     DateTime?
  closedAt      DateTime?

  game          Game          @relation(fields: [gameId], references: [id])
  bets          GameBet[]
  result        GameResult?
  settlements   GameSettlement[]

  @@unique([gameId, roundNumber])
  @@index([gameId, status])
  @@index([status, bettingEndsAt])
  @@map("game_rounds")
}

// ============================================================
// GAME BETS
// ============================================================

model GameBet {
  id             String   @id @default(uuid())
  roundId        String
  playerId       String
  optionId       String
  amount         Decimal 
  potentialPayout Decimal
  status         String   @default("pending") // pending, won, lost, refunded, cancelled
  payout         Decimal?
  multiplierSnapshot Decimal? // Multiplier at time of bet
  idempotencyKey String   @unique
  txRef          String?  // Wallet transaction reference
  metadata       String?    // Bet metadata
  createdAt      DateTime @default(now())
  settledAt      DateTime?

  round          GameRound      @relation(fields: [roundId], references: [id])
  player         Player         @relation(fields: [playerId], references: [id])
  option         GameOption     @relation(fields: [optionId], references: [id])
  settlement     GameSettlement?

  @@index([roundId])
  @@index([playerId, createdAt])
  @@index([status])
  @@map("game_bets")
}

// ============================================================
// GAME RESULTS
// ============================================================

model GameResult {
  id           String   @id @default(uuid())
  roundId      String   @unique
  optionId     String   // Winning option ID
  winningLabel String
  resultData   String     @default("{}") // Card values, reel positions, etc.
  processedAt  DateTime @default(now())
  processedBy  String   @default("system") // system | admin
  seed         String?  // RNG seed for audit
  metadata     String?

  round        GameRound @relation(fields: [roundId], references: [id])
  option       GameOption @relation(fields: [optionId], references: [id])

  @@map("game_results")
}

// ============================================================
// GAME SETTLEMENTS
// ============================================================

model GameSettlement {
  id          String   @id @default(uuid())
  roundId     String
  betId       String   @unique // Prevents double payout
  playerId    String
  payout      Decimal 
  status      String   @default("pending") // pending, completed, failed
  txRef       String?  // Wallet transaction reference
  settledAt   DateTime?
  createdAt   DateTime @default(now())

  round       GameRound @relation(fields: [roundId], references: [id])
  bet         GameBet   @relation(fields: [betId], references: [id])
  player      Player    @relation(fields: [playerId], references: [id])

  @@index([roundId])
  @@index([playerId])
  @@map("game_settlements")
}

// ============================================================
// GAME ASSETS
// ============================================================

model GameAsset {
  id          String   @id @default(uuid())
  gameId      String
  type        String   // thumbnail, banner, icon, background, character, animation, sound, music
  name        String
  url         String
  fileSize    Int?
  mimeType    String?
  metadata    String?    // Width, height, duration, etc.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game        Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("game_assets")
}

// ============================================================
// GAME LOCALIZATION
// ============================================================

model GameLocalization {
  id        String @id @default(uuid())
  gameId    String
  locale    String // en, es, zh, hi, ar, etc.
  key       String // rules.title, rules.bet_button, etc.
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game      Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, locale, key])
  @@map("game_localizations")
}

// ============================================================
// VIRTUAL ECONOMY
// ============================================================

model CoinPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  priceUsd      Decimal 
  priceLocal    Decimal?
  currency      String   @default("USD")
  baseCoins     Int
  bonusCoins    Int      @default(0)
  isSpecialOffer Boolean @default(false)
  isPopular     Boolean  @default(false)
  expiryDays    Int      @default(30)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  isVisibleInStore Boolean @default(true)
  image         String?
  metadata      String?    // Store visibility, categories, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paymentOrders PaymentOrder[]

  @@map("coin_packages")
}

model DiamondPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  priceUsd      Decimal 
  baseDiamonds  Int
  bonusDiamonds Int      @default(0)
  isSpecialOffer Boolean @default(false)
  isPopular     Boolean  @default(false)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("diamond_packages")
}

model Gift {
  id          String   @id @default(uuid())
  name        String
  icon        String
  animation   String?
  coinPrice   Decimal 
  category    String   @default("general") // general, special, seasonal, premium
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  senderRules String?    // Who can send
  receiverRules String?  // Who can receive
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions GiftTransaction[]

  @@map("gifts")
}

model GiftTransaction {
  id          String   @id @default(uuid())
  giftId      String
  senderId    String
  receiverId  String
  roomId      String?  // Live room ID if sent in room
  quantity    Int      @default(1)
  totalCost   Decimal 
  txRef       String   @unique // Idempotency key
  metadata    String?
  createdAt   DateTime @default(now())

  gift        Gift          @relation(fields: [giftId], references: [id])
  sender      Player        @relation("Sender", fields: [senderId], references: [id])
  receiver    Player        @relation("Receiver", fields: [receiverId], references: [id])
  room        LiveRoom?     @relation(fields: [roomId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@map("gift_transactions")
}

// ============================================================
// PAYMENTS
// ============================================================

model PaymentOrder {
  id              String   @id @default(uuid())
  playerId        String
  packageId       String?
  packageType     String   // coin, diamond
  provider        String   // stripe, apple, google, manual, bank_transfer
  externalOrderId String?
  currency        String   @default("USD")
  amountCents     Int
  tokenAmount     Int      // coins or diamonds to credit
  status          String   @default("pending") // pending, completed, failed, refunded
  receiptData     String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player          Player      @relation(fields: [playerId], references: [id])
  coinPackage     CoinPackage? @relation(fields: [packageId], references: [id])

  @@index([playerId, createdAt])
  @@map("payment_orders")
}

// ============================================================
// LIVE ROOMS
// ============================================================

model LiveRoom {
  id           String   @id @default(uuid())
  hostId       String
  title        String
  cover        String?
  description  String?
  roomType     String   @default("live") // live, voice, party
  status       String   @default("active") // active, ended, suspended
  viewerCount  Int      @default(0)
  maxViewers   Int      @default(10000)
  isPrivate    Boolean  @default(false)
  accessLevel  String   @default("public") // public, followers, private
  region       String?  // Global, South Asia, Middle East, etc.
  category     String?
  tags         String?
  settings     String?    // Room-specific settings
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  endedAt      DateTime?

  host         Player        @relation(fields: [hostId], references: [id])
  members      RoomMember[]
  messages     Message[]
  roomGifts    GiftTransaction[]
  reports      Report[]

  @@index([hostId])
  @@index([status, roomType])
  @@index([region, category])
  @@map("live_rooms")
}

model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  playerId  String
  role      String   @default("viewer") // host, co_host, moderator, viewer
  isMuted   Boolean  @default(false)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id])

  @@unique([roomId, playerId])
  @@map("room_members")
}

// ============================================================
// MESSAGING
// ============================================================

model Message {
  id         String   @id @default(uuid())
  roomId     String?
  senderId   String
  receiverId String?  // For DMs
  type       String   @default("chat") // chat, system, notification, dm
  content    String
  metadata   String?
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  room       LiveRoom? @relation(fields: [roomId], references: [id])
  sender     Player    @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@map("messages")
}

// ============================================================
// SOCIAL
// ============================================================

model Post {
  id          String   @id @default(uuid())
  authorId    String
  content     String?
  imageUrl    String?
  videoUrl    String?
  type        String   @default("moment") // moment, story, live_clip
  likesCount  Int      @default(0)
  commentsCount Int    @default(0)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      Player        @relation(fields: [authorId], references: [id])
  likes       PostLike[]
  comments    PostComment[]

  @@index([authorId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  playerId  String
  createdAt DateTime @default(now())

  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id])

  @@unique([postId, playerId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  playerId  String
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id])

  @@index([postId, createdAt])
  @@map("post_comments")
}

model FollowRelation {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    Player @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   Player @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follow_relations")
}

model BlockRelation {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())

  blocker    Player @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    Player @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("block_relations")
}

// ============================================================
// AGENCIES & FAMILIES
// ============================================================

model Agency {
  id          String   @id @default(uuid())
  name        String
  description String?
  logo        String?
  ownerId     String   @unique
  level       Int      @default(1)
  memberCount Int      @default(0)
  isActive    Boolean  @default(true)
  settings    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       Player          @relation("AgencyOwner", fields: [ownerId], references: [id])
  members     AgencyMember[]

  @@map("agencies")
}

model AgencyMember {
  id        String   @id @default(uuid())
  agencyId  String
  playerId  String
  role      String   @default("member") // owner, admin, member
  joinedAt  DateTime @default(now())

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id])

  @@unique([agencyId, playerId])
  @@map("agency_members")
}

model Family {
  id          String   @id @default(uuid())
  name        String
  description String?
  logo        String?
  ownerId     String   @unique
  memberCount Int      @default(0)
  level       Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       Player          @relation("FamilyOwner", fields: [ownerId], references: [id])
  members     FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id        String   @id @default(uuid())
  familyId  String
  playerId  String
  role      String   @default("member") // owner, admin, member
  joinedAt  DateTime @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id])

  @@unique([familyId, playerId])
  @@map("family_members")
}

// ============================================================
// LEVELS, MEDALS, REWARDS, TASKS
// ============================================================

model Level {
  id          String   @id @default(uuid())
  level       Int      @unique
  name        String
  requiredXp  Int
  badge       String?
  frame       String?
  rewards     String?    // Rewards for reaching this level
  createdAt   DateTime @default(now())

  players     Player[]

  @@map("levels")
}

model Medal {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  category    String   @default("achievement") // achievement, special, event
  rarity      String   @default("common") // common, rare, epic, legendary
  criteria    String?    // Requirements to earn
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("medals")
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   // login_bonus, level_up, task_complete, achievement, event
  currency    String   @default("coins")
  amount      Int
  criteria    String?    // Requirements to claim
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  playerRewards PlayerReward[]

  @@map("rewards")
}

model PlayerReward {
  id        String   @id @default(uuid())
  playerId  String
  rewardId  String
  status    String   @default("pending") // pending, claimed, expired
  claimedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id])
  reward    Reward @relation(fields: [rewardId], references: [id])

  @@unique([playerId, rewardId])
  @@map("player_rewards")
}

model Task {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   // daily, weekly, achievement, event
  category    String?  // game, social, economy
  criteria    String     // What needs to be done
  rewardType  String   @default("coins")
  rewardAmount Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerTasks PlayerTask[]

  @@map("tasks")
}

model PlayerTask {
  id        String   @id @default(uuid())
  playerId  String
  taskId    String
  progress  Int      @default(0)
  target    Int      @default(1)
  status    String   @default("in_progress") // in_progress, completed, claimed
  completedAt DateTime?
  claimedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player @relation(fields: [playerId], references: [id])
  task      Task   @relation(fields: [taskId], references: [id])

  @@unique([playerId, taskId])
  @@map("player_tasks")
}

// ============================================================
// RANKINGS
// ============================================================

model Ranking {
  id          String   @id @default(uuid())
  name        String
  type        String   // global, game, regional, agency
  gameId      String?  // For game-specific rankings
  region      String?  // For regional rankings
  period      String   @default("daily") // daily, weekly, monthly, all_time
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     RankingEntry[]

  @@map("rankings")
}

model RankingEntry {
  id        String   @id @default(uuid())
  rankingId String
  playerId  String
  score     Int      @default(0)
  rank      Int?
  metadata  String?    // Additional ranking data
  period    String   // The period this entry is for
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ranking   Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([rankingId, playerId, period])
  @@index([rankingId, score])
  @@map("ranking_entries")
}

// ============================================================
// MODERATION & REPORTS
// ============================================================

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String   // player, live_room, post, message, game
  targetId    String
  reason      String
  category    String   @default("general") // spam, harassment, cheating, inappropriate, other
  description String?
  status      String   @default("pending") // pending, reviewing, resolved, dismissed
  assignedTo  String?  // Admin user ID
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  reporter    Player   @relation("Reporter", fields: [reporterId], references: [id])
  target      Player?  @relation("Target", fields: [targetId], references: [id])
  room        LiveRoom? @relation(fields: [roomId], references: [id])
  roomId      String?

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model ModerationAction {
  id          String   @id @default(uuid())
  adminId     String?  // Admin who performed action
  targetType  String   // player, room, post, message
  targetId    String
  action      String   // warn, mute, ban, unban, delete, restrict
  reason      String?
  duration    Int?     // Duration in hours for temporary actions
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  admin       Player?  @relation(fields: [adminId], references: [id], name: "ModerationAdmin")
  player      Player   @relation(fields: [targetId], references: [id], name: "ModerationTarget")

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  playerId  String
  type      String   // system, game, social, reward, alert
  title     String
  content   String
  data      String?    // Additional notification data
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id])

  @@index([playerId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  // Player or admin ID
  actorType  String   @default("system") // player, admin, system
  action     String   // BET_PLACED, ROUND_SETTLED, ADMIN_OVERRIDE, etc.
  entityType String   // bet, round, player, config, wallet
  entityId   String?
  before     String?    // Snapshot before
  after      String?    // Snapshot after
  ipAddress  String?
  userAgent  String?
  requestId  String?
  metadata   String?
  createdAt  DateTime @default(now())

  admin      AdminUser? @relation(fields: [actorId], references: [id])
  player     Player?    @relation("AuditPlayer", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("general")
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(true)
  allowedRoles String  @default("super_admin")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ============================================================
// DESIGN TOKENS (Frontend Theming)
// ============================================================

model DesignToken {
  id        String   @id @default(uuid())
  scope     String   // global, page:games, page:admin, game:greedy_monkey
  key       String   // primaryColor, bgGradient, cardBg
  value     String   // hex, gradient, css string
  label     String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@map("design_tokens")
}

model GameBranding {
  id            String   @id @default(uuid())
  gameSlug      String   @unique
  displayName   String?
  logoUrl       String?
  iconEmoji     String?
  primaryColor  String?
  accentColor   String?
  bgGradient    String?
  tagline       String?
  isVisible     Boolean  @default(true)
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  @@map("game_branding")
}
