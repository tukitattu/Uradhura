  currentTurnSeatNo Int?
  pot            Int             @default(0)
  stake          Int             @default(0)
  stakeLevel     Int             @default(0)
  rakeCoins      Int             @default(0)
  rakePercent    Int             @default(0)
  seedCommitHash String
  seedClientSeed String
  seedNonce      Int             @default(0)
  seedServerSeed String?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())

  table          TeenPattiTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  actions        TeenPattiAction[]
