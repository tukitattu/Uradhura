  playerId  String
  type      String   // system, game, social, reward, alert
  title     String
  content   String
  data      String?    // Additional notification data
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id])

  @@index([playerId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
