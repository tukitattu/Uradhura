}

model Medal {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String
  category    String   @default("achievement") // achievement, special, event
  rarity      String   @default("common") // common, rare, epic, legendary
  criteria    String?    // Requirements to earn
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("medals")
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   // login_bonus, level_up, task_complete, achievement, event
  currency    String   @default("coins")
  amount      Int
