model TeenPattiSeatHand {
  id          String          @id @default(uuid())
  handId      String
  seatNo      Int
  playerId    String?
  isBot       Boolean         @default(false)
  cards       String          // JSON [{r,s},...] server-only, never broadcast
  isSeen      Boolean         @default(false)
  chipsIn     Int             @default(0)
  committed   Int             @default(0)
  folded      Boolean         @default(false)
  allIn       Boolean         @default(false)
  result      Int             @default(0) // net chips won/lost this hand

