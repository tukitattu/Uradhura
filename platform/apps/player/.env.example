# Local dev / preview override — the API + Socket.IO backend reachable from
# your phone on the same Wi-Fi. EAS production builds override this via
# eas.json (production.env). Copy to .env and edit the IP for your machine.

# REST base for axios (<base>/api/v1/...)
EXPO_PUBLIC_API_URL=http://192.168.0.136:4002/api/v1