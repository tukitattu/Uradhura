# Mobile app runtime config — loaded by flutter_dotenv at boot.
# Bundled as an asset (declared in pubspec.yaml). DO NOT put secrets here in
# release builds — anything bundled in the APK is reverse-engineerable. Use
# this for non-sensitive config like API URLs and feature flags.

# App personality / feature-gate switch — see `lib/core/config/app_config.dart`
# (`AppMode` enum + `AppConfig.appMode`).
#   party    → social live rooms + gifting lead the layout (default).
#   earning  → earning-flavoured surfaces (recharge offers, host program,
#              tasks, withdrawals) lead the layout. Reserved for the
#              future market-push build.
# Anything unrecognised falls back to `party`.
APP_MODE=earning

# Backend API base URL.
#   Physical device  → host machine's LAN IP. Phone & PC must be on the same
#                      Wi-Fi. Detected from this machine: 192.168.68.51
#   Android emulator → 10.0.2.2 (loops back to host's localhost)
#   iOS simulator    → localhost
# Port 6001, not 6000 — WebView games run in a browser engine, and
# browsers block port 6000 as unsafe (X11). Backend local dev
# listens on 6001 (see dearlive-backend/.env).
# NOTE for Leadercc game testing: the vendor's game server only calls
# https://api.dearlive.pro, so launch tokens MUST be minted there too —
# minting from a local backend puts the token in the wrong Redis and the
# game fails with "Connection error 10001". Point at production while
# testing vendor games; switch back to the local URL for normal dev.
# API_BASE_URL=http://10.0.2.2:6001/api/v1
# API_BASE_URL=http://192.168.68.51:6001/api/v1
API_BASE_URL=https://api.dearlive.pro/api/v1

# Base for room share links (final link = <base>/r/<roomId>). Leave
# unset in dev — it falls back to API_BASE_URL so LAN links work.
# Production uses the branded domain; the dearlive.pro reverse proxy
# must route /r/* to the backend's /api/v1/r/*.
# SHARE_BASE_URL=https://dearlive.pro

# WebView-hosted games origin — points at wherever the
# `lrlive-games/` static files are being served. Same host rules
# as API_BASE_URL above (physical phone → LAN IP, emulator →
# 10.0.2.2). The python dev server runs on :5002 by convention.
# Production: https://games.dearlive.pro (or whatever CDN you ship to).
# GAMES_BASE_URL=http://10.0.2.2:5002
# GAMES_BASE_URL=http://192.168.68.51:5002    # physical phone on the same Wi-Fi
GAMES_BASE_URL=https://games.dearlive.pro   # production

ENABLE_LOGGING=true

# Cloudinary (only the cloud name + upload preset — public values, safe to bundle).
# Used for direct uploads from the app via /media/signature endpoint.
CLOUDINARY_CLOUD_NAME=dpwcbgzsp
CLOUDINARY_UPLOAD_PRESET=ml_default

# Google Sign-In — Firebase Web Client ID (auto-created when you enabledfgd
# Google as a sign-in method in Firebase Console).
# Find it in Firebase Console → Project Settings → General → Web SDK
# configuration → Web client ID. Same value goes in backend .env as
# GOOGLE_CLIENT_IDS so token verification works.
GOOGLE_WEB_CLIENT_ID=994277465775-m44opqe114brunqu8dgn89rnimbb1g91.apps.googleusercontent.com

# Agora App ID is needed at boot for the SDK; the App Certificate is server-only.
AGORA_APP_ID=

# RevenueCat — public app-specific SDK keys. Safe to bundle (they only allow
# purchase calls scoped to one platform; the secret server key is never on
# the client). Find under RevenueCat dashboard → Project Settings → API Keys.
REVENUECAT_GOOGLE_KEY=goog_POFSawxzRPzIYdTEUABwsMIuIwE
REVENUECAT_APPLE_KEY=
